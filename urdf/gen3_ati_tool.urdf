  <!-- Lorenzo, 2026-10-21: what is bolted on the flange, ATI Mini40 + adapters + free spring +
       tri-pad, 0.150 kg in all, rigidly on end_effector_link. CoM ~35 mm out along z_ee
       (mass-weighted guess: ATI near the flange, spring + tri-pad 40 g at ~70 mm); inertia of a
       25 mm x 100 mm cylinder. Kinematics = gen3.urdf: tool_frame stays AT the flange. -->
  <link name="ati_tool_payload">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.035" />
      <mass value="0.150" />
      <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.000047" />
    </inertial>
  </link>
  <joint name="ati_tool_payload_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="end_effector_link" />
    <child link="ati_tool_payload" />
  </joint>
